{
  "version": "2.0.0",
  "options": {},
  "presentation": {
    "reveal": "silent",
    "revealProblems": "onProblem"
  },
  "tasks": [
    {
      "label": "preproc",
      "type": "shell",
      "command": "${workspaceFolder}\\Src\\preproc.ahk",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "${workspaceFolder}\\Src\\Build.ahk",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["preproc"]
    },
    {
      "label": "install",
      "type": "shell",
      "command": "${workspaceFolder}\\Src\\Install.ahk",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}\\Src\\Tests.ahk",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
